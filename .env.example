# Findely — canonical env template
# Copy this file to `.env.local` and fill in the values below.
# Never commit `.env.local`.

# --- Supabase (required for auth + persistence) ------------------------------
# Create a project at https://supabase.com/, then find these under
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — optional, server-side only. Used for admin tasks
# (API-key lookup by prefix, etc.). NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Places (optional but recommended) --------------------------------
# 1. Enable the Places API in https://console.cloud.google.com/
# 2. Create an API key under APIs & Services → Credentials
# 3. Restrict the key (HTTP referrers or IPs) — strongly recommended
#
# GOOGLE_MAPS_API_KEY is server-only — used by /api/search and /api/search/geo.
# Restrict by IP in Google Cloud Console. NEVER expose to the browser.
GOOGLE_MAPS_API_KEY=

# NEXT_PUBLIC_GOOGLE_MAPS_KEY is client-side — used for the Google Maps JS map
# on /app/geo. This key is PUBLIC by design and MUST be restricted in Google
# Cloud Console by HTTP referrer (e.g. https://yourdomain.com/*).
#
# Required Google Cloud APIs for this key:
#   - Maps JavaScript API
#   - Geocoding API
#
# The server-side Places API calls use GOOGLE_MAPS_API_KEY above, not this one.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyCzIzPAVuFZw91aGCzqywW79FnSg-c192k

# Set to "false" to hide Google Places even if a key is present.
FINDELY_ENABLE_GOOGLE_MAPS=true

# --- Runtime environment -----------------------------------------------------
# development | preview | production
NEXT_PUBLIC_FINDELY_ENV=development

# Legacy alias — kept for backward compatibility with older deploys.
# Leave blank if you set NEXT_PUBLIC_FINDELY_ENV above.
NEXT_PUBLIC_APP_ENV=development

# --- Demo & fallback behaviour ----------------------------------------------
# FINDELY_DEMO_MODE=true allows unauthenticated visitors to browse /app
# with sample data. Defaults to true in non-production, false in production.
FINDELY_DEMO_MODE=false

# FINDELY_ALLOW_MOCK_FALLBACK=true lets /api/search silently fall back to
# the mock provider when Google Places fails. Defaults to true in
# non-production, false in production — production searches must never
# silently return fake data.
FINDELY_ALLOW_MOCK_FALLBACK=true

# --- Dev plan override (local only, never set in production) ----------------
FINDELY_DEV_PLAN_OVERRIDE=pro



