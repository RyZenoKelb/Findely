# Findely — local environment example
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local`.

# --- Google Places (optional) ------------------------------------------------
# 1. Create a key in https://console.cloud.google.com/
# 2. Enable the "Places API" product
# 3. Create an API key
# 4. Restrict the key (HTTP referrers or IP list) — strongly recommended
# 5. Paste the key below
GOOGLE_MAPS_API_KEY=example-key

# When "false", the Google Places provider is hidden even if a key is present.
# Default: true (enabled whenever a key is set).
FINDELY_ENABLE_GOOGLE_MAPS=true

# --- Placeholder providers (future) -----------------------------------------
# FINDELY_ENABLE_GOOGLE_SEARCH=true
# FINDELY_ENABLE_DIRECTORY=true
